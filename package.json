{
  "name": "hr-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply daymark-hr --local",
    "cf:migrate:remote": "wrangler d1 migrations apply daymark-hr --remote",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node --disable-warning=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
